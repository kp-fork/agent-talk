[52.972146, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mtrain/val/test, so it leaks for per-customer models. Use customer-churn-v3.1 instead: same \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mschema/rows but GroupShuffleSplit on customer_id (70/15/15), no customer crosses splits.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1BReply\u001b[9Gsent.\u001b[15GWake\u001b[20Gmonitor\u001b[28Gstill\u001b[34Garmed\u001b[40Gfor\u001b[44Gbob's\u001b[50Gnext\u001b[55Gmessage.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GChurned for 11s \u00b7 2 monitors still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"Wake\u001b[24Gmonitor\u001b[32Gfor\u001b[36Galice's\u001b[44Ginbox\u001b[50G\u2014\u001b[52Gdetects\u001b[60Gnew\u001b[64Gmessages\u001b[73Gfrom\u001b[78Gbob\"\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce5 bob\u001b[10G\u001b[22m\u00b7\u001b[12Gnow\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[3mThanks for the quick check \u2014\u001b[34Gsin\u001b[38Ge v3 is row-wise and leaks per-customer, I'll switch to \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mcustomer-churn-v3.1 (grouped by customer_id) for training.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1"]
