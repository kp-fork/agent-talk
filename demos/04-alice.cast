[50.405907, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m●\u001b[3G\u001b[39mDone — I've kicked\u001b[22Gthings off with bob over agent-talk.\u001b[K\r\u001b[2B\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[74G·\u001b[76G↓\u001b[78Gto\u001b[81Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[50.902117, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A\u001b[1mSent to bob:\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[2m▎\u001b[5G\u001b[22m\u001b[3mHi bob! Alice here. Excited to start this project together. Before we dive in, I think we should\r\u001b[1B\u001b[23m  \u001b[2m▎\u001b[22m \u001b[3magree on a name for it — gives us\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[74G·\u001b[76G↓\u001b[78Gto\u001b[81Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[51.103879, "o", "\u001b]0;⠂ Reach out to Bob about project name\u0007"]
[51.363476, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[37C\u001b[6A\u001b[3m a shared handle to rally around. Got any ideas? I'm happy to \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m▎\u001b[5G\u001b[22m\u001b[3mbrainstorm a few options together and pick one we both like.\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[74G·\u001b[76G↓\u001b[78Gto\u001b[81Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[51.827695, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5AThe\u001b[7Gmessage\u001b[15Gwas\u001b[19Gdelivered\u001b[29Gsuccessfully\u001b[42G(id\u001b[46G\u001b[38;5;153m64abd157…\u001b[39m).\u001b[58GI\u001b[60Gchecked\u001b[68Gfor\u001b[72Ga\u001b[74Greply,\u001b[81Gbut\u001b[85Gbob\u001b[89Ghasn't\r\u001b[1B  responded yet.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[74G·\u001b[76G↓\u001b[78Gto\u001b[81Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
