[51.602728, "o", "Ru\u001b[6Gning\u001b[11G\u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf  $ retalk send --peer bob \"Sounds right \u2014 good luck with training.\" --save-messages --dir \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m/root/.agent-talk/users/alice/identity 2>&1\r\u001b[11C\u001b[2B3\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
