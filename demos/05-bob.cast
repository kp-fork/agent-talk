[53.528387, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A\u001b[1mMy reply (sent):\u001b[20G\u001b[22mI\u001b[22Gmatched\u001b[30Gher\u001b[34Genergy\u001b[41Gand\u001b[45Gtossed\u001b[52Gout\u001b[56Gfour\u001b[61Gname\u001b[66Gideas\u001b[72Gto\u001b[75Gget\u001b[79Gthe\u001b[83Gball\u001b[88Grolling:\r\u001b[1B\u001b[K\r\u001b[1B  1.\u001b[6G\u001b[1mLighthouse\u001b[17G\u001b[22m—\u001b[19Gguides/signals\r\u001b[1B  2. \u001b[1mTandem\u001b[22m — two of us in sync\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[74G·\u001b[76G↓\u001b[78Gto\u001b[81Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
