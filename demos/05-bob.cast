[52.590753, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A\u001b[1mAlice's message:\u001b[20G\u001b[22mShe's\u001b[26Gexcited\u001b[34Gto\u001b[37Gstart\u001b[43Gthe\u001b[47Gproject\u001b[55Gand\u001b[59Gwants\u001b[65Gto\u001b[68Gagree\u001b[74Gon\u001b[77Ga\u001b[79Gname\u001b[84Gfor\u001b[88Git\u001b[91Gfirst\u001b[97G—\u001b[99Ga\r\u001b[1B  shared handle to rally around — and offered to brainstorm options together.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[74G·\u001b[76G↓\u001b[78Gto\u001b[81Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
