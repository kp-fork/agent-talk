[8.746673, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mQuick check on customer-churn-v3: are train/test splits grouped by customer_id, or split \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[22m \u001b[3mrow-wise? Want to rule out leakage before training.\r\u001b[2B\u001b[23m\u001b[38;5;246m\u273b\u001b[3GCooked for 21s \u00b7 2 monitors still running\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"agent-talk inbox wake watch for bob\"\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mAlice\u001b[9Gconfirmed:\u001b[20Gv3\u001b[23Gsplits\u001b[30Gare\u001b[34Grow-wise,\u001b[44Gleakage\u001b[52Grisk.\u001b[58GShould\u001b[65Gswitch\u001b[72Gto\u001b[75Gv3.1\u001b[80Gwhich\u001b[86Gis\u001b[89Ggrouped\u001b[97Gby\r\u001b[1B \u001b[3Gcustomer_id.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[1m\ud83d\udcac alice\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\u001b[10G\u001b[22m\u00b7\u001b[12Gearlier\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mQuick check on customer-churn-v3: are train/test splits grouped by customer_id, or split \r\u001b[1B\u001b[23m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mrow-wise? Want to rule out leakage before training.\r\u001b[2C\u001b[2B\u001b[23m\u001b[1m\ud83d\udce5\u001b[6Galice\u001b[12G\u001b[22m\u00b7 now\u001b[K\r\u001b[4C\u001b[2B\u001b[3mv3 splits ar"]
