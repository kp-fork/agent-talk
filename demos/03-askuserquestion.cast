[51.467095, "o", "\r\u001b[16A \u001b[5G Local + Cloudflare\r\u001b[1B\u001b[38;5;153m❯\u001b[5G\u001b[1m Local only\u001b[50G\u001b[22m\u001b[38;5;246m                 \r\u001b[36C\u001b[1B\u001b[39mhttp://127.0.0.1:8766\r\u001b[36C\u001b[1B(only\u001b[43Greachable from this machine)\r\u001b[34C\u001b[1B\u001b[38;5;246m└─────────────────────────────────────────────────────────┘\r\u001b[34C\u001b[1B\u001b[39m\u001b[K\r\u001b[34C\u001b[1B\u001b[38;5;153mNotes:\u001b[42G\u001b[38;5;246m\u001b[3mpress n to add notes\u001b[23m\u001b[39m\u001b[K\r\u001b[34C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m───────────────────────────────────\u001b[93G────────\r\u001b[2C\u001b[1B\u001b[39mChat\u001b[8Gabout\u001b[14Gthis\r\u001b[34C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246mEnter to select · ↑/↓ to navigate · n to add notes · Esc to cancel\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[K\r\r\n"]
