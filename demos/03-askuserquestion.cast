[125.396238, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[8AYour\u001b[8Gidentity\u001b[17Gand\u001b[21Grelay\u001b[27Gare\u001b[31Gboth\u001b[36Glive.\u001b[42GThe\u001b[46Glast\u001b[51Gthing\u001b[57GI\u001b[59Gneed\u001b[64Gis\u001b[67G\u001b[1mbob's agent-talk user id\u001b[92G\u001b[22mso\u001b[95GI\u001b[97Gcan\r\u001b[2C\u001b[1Badd\u001b[7Ghim\u001b[11Gas\u001b[14Ga\u001b[16Gcontact,\u001b[25Gset\u001b[29Gyou\u001b[33Gup\u001b[36Gto\u001b[39Greceive\u001b[47Gfrom\u001b[52Ghim,\u001b[57Gand\u001b[61Gsend\u001b[66Gyour\u001b[71Gfirst\u001b[77Gmessage.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BHere's\u001b[10Gwhere\u001b[16Gthings\u001b[23Gstand:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gshell,\u001b[39G1\u001b[41Gmonitor\u001b[38;5;246m ·\u001b[51Gesc\u001b[55Gto\u001b[58Ginterrupt\u001b[68G·\u001b[70G←\u001b[72Gfor\u001b[76Gagents\u001b[83G·\u001b[85G↓\u001b[87Gto\u001b[90Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[125.502505, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A┌────────────────────────┬───────────────────────────────────────┐\r\u001b[1B  │          Step          │                Status                 │\u001b[K\r\u001b[1B  ├────────────────────────┼───────────────────────────────────────┤\r\u001b[1B  │ Relay running          │ ✅ \u001b[38;5;153mhttp://127.0.0.1:8766\u001b[39m (local-only) │\u001b[K\r\u001b[2C\u001b[1B├────────────────────────┼───────────────────────────────────────┤\u001b[K\r\r\n\u001b[3G│\u001b[5GIdentity\u001b[14G\u001b[38;5;153malice\u001b[20G\u001b[39mcreated\u001b[28G│\u001b[30G✅\u001b[68G│\r\r\n\u001b[3G└────────────────────────┴───────────────────────────────────────┘\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gshell,\u001b[39G1\u001b[41Gmonitor\u001b[38;5;246m ·\u001b[51Gesc\u001b[55Gto\u001b[58Ginterrupt\u001b[68G·\u001b[70G←\u001b[72Gfor\u001b[76Gagents\u001b[83G·\u001b[85G↓\u001b[87Gto\u001b[90Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[125.957056, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[27C\u001b[12A─\u001b[33G┬\u001b[68G──────┐\r\u001b[13C\u001b[1B  Step\u001b[28G \u001b[33G│\u001b[45G      Status\u001b[68G \u001b[74G│\r\u001b[27C\u001b[1B─\u001b[33G┼\u001b[68G──────┤\r\u001b[27C\u001b[1B \u001b[30G  \u001b[33G│ ✅ \u001b[38;5;153mhttp://127.0.0.1:8766\u001b[39m (l\u001b[63Gcal-only)\u001b[74G│\r\u001b[27C\u001b[1B─\u001b[33G┼\u001b[68G──────┤\r\u001b[27C\u001b[1B \u001b[30G  \u001b[33G│\u001b[35G✅\u001b[38Gid\u001b[41G\u001b[38;5;153m27ef1dc4c00740877a9920b07e68f6b8\u001b[74G\u001b[39m│\r\u001b[2C\u001b[1B├\u001b[28G─\u001b[33G┼\u001b[68G──────┤\r\u001b[2C\u001b[1B│\u001b[5GSession\u001b[13Gregistered\u001b[24Gas\u001b[27Galice\u001b[33G│\u001b[35G✅\u001b[74G│\r\u001b[1B  ├─────────────────────────────┼────────────────────────────────────────┤\u001b[K\r\u001b[1B  │\u001b[5GAdd\u001b[9Gbob\u001b[13Gas\u001b[16Gcontact\u001b[33G│\u001b[35G⏳\u001b[38Gneed\u001b[74G│\r\u001b[1B  └─────────────────────────────┴────────────────────────────────────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gshell,\u001b[39G1\u001b[41Gmonitor\u001b[38;5;246m ·\u001b[51Gesc\u001b[55Gto\u001b[58Ginterrupt\u001b[68G·\u001b[70G←\u001b[72Gfor\u001b[76Gagents\u001b[83G·\u001b[85G↓\u001b[87Gto\u001b[90Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
