[49.905379, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[48;5;153m\u001b[38;5;16m ☐ Relay host \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;231m\u001b[1mWhere should we host your relay? Since you want to message bob, the relay needs to be reachable by \r\u001b[1Bwhichever machine bob's agent runs on.\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[38;5;153m❯\u001b[38;5;246m 1.\u001b[38;5;153m\u001b[1m Local\u001b[12G+\u001b[14GCloudflare\u001b[35G\u001b[22m\u001b[38;5;246m┌─────────────────────────────────────────────────────────┐\u001b[39m\r\r\n\u001b[2G\u001b[38;5;246m 2.\u001b[6G\u001b[39mLocal\u001b[12Gonly\u001b[35G\u001b[38;5;246m│\u001b[37G\u001b[39mretalk-server\u001b[51G(localhost:8766)\u001b[38;5;246m \u001b[93G│\u001b[39m\r\r\n\u001b[2G\u001b[38;5;246m 3.\u001b[6G\u001b[39mHugging\u001b[14GFace\u001b[19GSpace\u001b[35G\u001b[38;5;246m│\u001b[45G\u001b[39m│\u001b[38;5;246m \u001b[93G│\u001b[39m\r\r\n\u001b[2G\u001b[38;5;246m 4.\u001b[6G\u001b[39mGCP\u001b[10GVM\u001b[35G\u001b[38;5;246m│\u001b[45G\u001b[39m▼\u001b[38;5;246m \u001b[93G│\u001b[39m\r\r\n\u001b[35G\u001b[38;5;246m│\u001b[37G\u001b[39mcloudflared\u001b[49Gquick\u001b[55Gtunnel\u001b[38;5;246m \u001b[93G│\u001b[39m\r\r\n\u001b[35G\u001b[38;5;246m│\u001b[45G\u001b[39m│\u001b[38;5;246m \u001b[93G│\u001b[39m\r\r\n\u001b[35G\u001b[38;5;246m│\u001b[45G\u001b[39m▼\u001b[38;5;246m \u001b[93G│\u001b[39m\r\r\n\u001b[35G\u001b[38;5;220m├───\u001b[40G✂\u001b[42G───\u001b[46G1\u001b[48Glines\u001b[54Ghidden\u001b[61G────────────────────────────────┤\u001b[39m\r\r\n\u001b[35G\u001b[38;5;246m└─────────────────────────────────────────────────────────┘\u001b[39m\r\r\n\r\r\n\u001b[35G\u001b[38;5;153mNotes:\u001b[42G\u001b[38;5;246m\u001b[3mpress\u001b[48Gn\u001b[50Gto\u001b[53Gadd\u001b[57Gnotes\u001b[23m\u001b[39m\r\r\n\r\r\n\u001b[38;5;246m─