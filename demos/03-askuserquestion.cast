[106.052761, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m●\u001b[3G\u001b[39mAlice's identity is created. Her user id (share this with\u001b[61Gbob\u001b[65Gout-of-band)\u001b[78Gis:\r\u001b[2B  \u001b[38;5;153m\u001b[1m27ef1dc4c00740877a9920b07e68f6b8\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gshell,\u001b[39G1\u001b[41Gmonitor\u001b[38;5;246m ·\u001b[51Gesc\u001b[55Gto\u001b[58Ginterrupt\u001b[68G·\u001b[70G←\u001b[72Gfor\u001b[76Gagents\u001b[83G·\u001b[85G↓\u001b[87Gto\u001b[90Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
