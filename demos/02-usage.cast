[118.636293, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[8AThere's\u001b[11G\u001b[1mone new message from bob\u001b[22m:\r\u001b[2B \u001b[3G\u001b[2m▎\u001b[22m \u001b[1m\u001b[3mbob:\u001b[22m hi alice, got your message!\r\u001b[2B\u001b[23m  Details:\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G↓\u001b[63Gto\u001b[66Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
