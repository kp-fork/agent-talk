[130.995453, "o", "\u001b[?25l\u001b[7D\u001b[3B\r\u001b[1A\u001b[38;5;153m/exit                         Exit the CLI\u001b[39m\r\r\n\u001b[38;5;246m/check-session-usage\u001b[31GCheck\u001b[37Gthe\u001b[41GClaude\u001b[48GCode\u001b[53G\"Current\u001b[62Gsession\"\u001b[71Gusage\u001b[77Gpercentage\u001b[88Gby\u001b[39m\r\r\n\u001b[31G\u001b[38;5;246mspawning\u001b[40Ga\u001b[42Gthrowaway\u001b[52Ginteractive\u001b[64GClaude\u001b[71Gsession\u001b[79Gin\u001b[82Gtmux,\u001b[88Gsending\u001b[96G…\u001b[39m\r\r\n\u001b[38;5;246m/context\u001b[31GVisualize\u001b[41Gcurrent\u001b[49Gcontext\u001b[57Gusage\u001b[63Gas\u001b[66Ga\u001b[68Gcolored\u001b[76Ggrid\u001b[39m\r\r\n\u001b[38;5;246m/usage-credits\u001b[31GConfigure\u001b[41Gusage\u001b[47Gcredits\u001b[55Gto\u001b[58Gkeep\u001b[63Gworking\u001b[71Gwhen\u001b[76Gyou\u001b[80Ghit\u001b[84Ga\u001b[86Glimit\u001b[39m\r\r\n\u001b[38;5;246m*\u001b[3G/agent-talk:init\u001b[20G–\u001b[22G(agent-talk)\u001b[35GSet\u001b[39Gup\u001b[42Gor\u001b[45Gresume\u001b[52GTHIS\u001b[57Gsession's\u001b[67Gretalk\u001b[74Guser\u001b[79G—\u001b[81Gfrom\u001b[86Gyour\u001b[91Gexist…\u001b[39m\r\r\n\u001b[38;5;246m*\u001b[3G/agent-talk:relay\u001b[21G–\u001b[23G(agent-talk)\u001b[36GSet\u001b[40Gup,\u001b[44Gcheck,\u001b[51Gstop,\u001b[57Gor\u001b[60Gdelete\u001b[67Ga\u001b[69Gretalk\u001b[76Grelay\u001b[82Gserver\u001b[89G(retalk…\u001b[39m\r\r\n\u001b[38;5;246m/memory\u001b[31GOpen\u001b[36Ga\u001b[38Gmemory\u001b[45Gfile\u001b[50Gin\u001b[53Gyour\u001b[58Geditor\u001b[39m\r\r\n\u001b[38;5;246m/ultraplan\u001b[31GDraft\u001b[37Gan\u001b[40Geditable\u001b[49Gplan\u001b[54Gin\u001b[57GClaude\u001b[64GCode\u001b[69Gon\u001b[72Gthe\u001b[76Gweb\u001b[80G(a\u001b[83Gfew\u001b[87Gminutes)\u001b[96G·\u001b[39m\r\r\n\u001b[31G\u001b[38;5;246mSee\u001b[35Ghttps://code.claude.com/docs/en/claude-code-on-the-web\u001b[39m\r\r\n\u001b[38;5;246m/passes\u001b[31GShare\u001b[37Ga\u001b[39Gfree\u001b[44Gweek\u001b[49Gof\u001b[52GClaude\u001b[59GCode\u001b[64Gwith\u001b[69Gfriends\u001b[77Gand\u001b[81Gearn\u001b[86Gusage\u001b[39m\r\r\n\u001b[31G\u001b[38;5;246mcredits\u001b[39m\r\r\n\u001b[38;5;246m/fork\u001b[31GSpawn\u001b[37Ga\u001b[39Gbackground\u001b[50Gagent\u001b[56Gthat\u001b[61Ginherits\u001b[70Gthe\u001b[74Gfull\u001b[79Gconversation\u001b[39m\r\r\n\u001b[38;5;246m/clear\u001b[31GStart\u001b[37Ga\u001b[39Gnew\u001b[43Gsession\u001b[51Gwith\u001b[56Gempty\u001b[62Gcontext;\u001b[71Gprevious\u001b[80Gsession\u001b[88Gstays\u001b[94Gon\u001b[39m\r\r\n\u001b[31G\u001b[38;5;246mdisk\u001b[36G(resumable\u001b[47Gwith\u001b[52G/resume)\u001b[39m\r\r\n\u001b[38;5;246m/compact\u001b[31GFree\u001b[36Gup\u001b[39Gcontext\u001b[47Gby\u001b[50Gsummarizing\u001b[62Gthe\u001b[66Gconversation\u001b[79Gso\u001b[82Gfar\u001b[39m\r\r\n\u001b[7C\u001b[18A\u001b[?25h"]
