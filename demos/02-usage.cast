[119.527488, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A-\u001b[5G\u001b[1mFrom:\u001b[11G\u001b[22mbob\u001b[15G(\u001b[38;5;153m033fec0605f22520339e43c469a3498f\u001b[39m)\u001b[50G—\u001b[52Gmatches\u001b[60Gyour\u001b[65Gsaved,\u001b[72Gdesignated\u001b[83Gpeer\r\u001b[1B  - \u001b[1mMessage id:\u001b[22m \u001b[38;5;153m1ffc9ba8a35642c9be63b5f060d87c1f\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G↓\u001b[63Gto\u001b[66Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[119.952688, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[8A-\u001b[5G\u001b[1mFrom:\u001b[11G\u001b[22mbob\u001b[15G(\u001b[38;5;153m033fec0605f22520339e43c469a3498f\u001b[39m)\u001b[50G—\u001b[52Gmatches\u001b[60Gyour\u001b[65Gsaved,\u001b[72Gdesignated\u001b[83Gpeer\r\u001b[4C\u001b[1B\u001b[1mMessage id:\u001b[22m \u001b[38;5;153m1f\u001b[20Gc9ba8a3564\u001b[31Gc9be63b5f060d87c1f\u001b[50G\u001b[39m\u001b[K\r\u001b[4C\u001b[1BIt's now auto-acked (the relay won't resend it).\r\u001b[2B  Want me to reply, or start a background \u001b[38;5;153m--follow\u001b[39m reader so any further messages from bob get\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G↓\u001b[63Gto\u001b[66Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[120.052369, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5Apushed\u001b[10Ginto\u001b[15Gthis\u001b[20Gsession\u001b[28Gin\u001b[31Greal\u001b[36Gtime?\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m✶\u001b[39m \u001b[38;5;174mEnchanting… \u001b[38;5;246m(13s · ↓\u001b[24G387 tokens)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;211m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m ·\u001b[30G\u001b[38;5;44m1\u001b[32Gmonitor\u001b[38;5;246m ·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G↓\u001b[63Gto\u001b[66Gmanage\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
